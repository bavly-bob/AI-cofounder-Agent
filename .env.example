# Copy to .env to override defaults. Placeholders only; no secrets needed.
OLLAMA_HOST=http://localhost:11434
# Weaker laptops: qwen3:4b or qwen3:1.7b
OLLAMA_MODEL=qwen3:8b
APP_PORT=8501
# Host port for the Docker Ollama service (docker compose up -d ollama)
OLLAMA_PORT=11434
# Phase 1 research budget (can only lower the built-in caps of 8 searches / 10 page fetches)
SEARCH_MAX_QUERIES=8
FETCH_MAX_PAGES=10
# Generic User-Agent for the free search/fetch tools. Never put personal contact details here.
HTTP_USER_AGENT=ai-cofounder-agent/0.1 (open-source research bot)
